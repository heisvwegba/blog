<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
        <!-- Basic SEO -->
        <title>{{ title | default("𝒱𝓌𝑒𝑔𝒷𝒶") }}</title>
        <meta name="description" content="{{ description | default("A minimalist blog on tech, building lean software, and indie hacking.") }}">
        <link rel="canonical" href="https://vwegba.vercel.app{{ page.url }}">

        <!-- Open Graph / Facebook / LinkedIn / Discord -->
        <meta property="og:type" content="article">
        <meta property="og:title" content="{{ title | default("𝒱𝓌𝑒𝑔𝒷𝒶") }}">
        <meta property="og:description" content="{{ description | default("A minimalist blog on tech, building lean software, and indie hacking.") }}">
        <meta property="og:url" content="https://vwegba.vercel.app{{ page.url }}">
        <meta property="og:site_name" content="Vwegba's Blog">
        <meta property="og:image" content="https://vwegba.vercel.app/css/icon.jpg">

        <!-- Twitter / X Cards -->
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ title | default("𝒱𝓌𝑒𝑔𝒷𝒶") }}">
        <meta name="twitter:description" content="{{ description | default("A minimalist blog on tech, building lean software, and indie hacking.") }}">
        <meta name="twitter:image" content="https://vwegba.vercel.app/css/icon.jpg">

        <!-- Preload fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        <!-- Site fonts -->
        <link href="https://fonts.googleapis.com/css2?family=Tinos:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Iosevka+Charon&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Anonymous+Pro&display=swap" rel="stylesheet">
        
        <link rel="icon" type="image/jpeg" href="/css/icon.jpg">
        <link rel="stylesheet" href="/css/style.css">
    </head>

    <body>
        <header>
            {% if page.url == "/" %}
            <h1>Info</h1>
            <p> 
                Hi! 👋🏻 <br>
                I'm Vwegba, <br>
                Indie hacker. I tattoo and play football in my spare time. 
                I also write about what I'm learning or building.
            </p>
            {% else %}
            <a href="/">← Back</a>
            {% endif %}
        </header>

        <main>
            {% if title %}
            <h1>{{ title }}</h1>
            {% endif %}

            {% if date %}
            <p><time>{{ date | dateFilter }}</time></p>
            {% endif %}

            {{ content | safe }}
        </main>

        <footer>
            <a href="https://github.com/heisvwegba">Github</a>
            <a href="mailto:maxwelleaster00@gmail.com">Email</a>
        </footer>
    </body>
</html>